<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The picture is drawn at the widget's own size, so it is stretched 1:1 and the tap zones below line up with it. -->
    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cal_name"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/open_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="54"
            android:contentDescription="@string/cal_name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="46"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/open_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/cal_name" />

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:contentDescription="Previous event" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:contentDescription="Next event" />

            <ImageView
                android:layout_width="7dp"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
