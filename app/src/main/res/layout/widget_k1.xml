<?xml version="1.0" encoding="utf-8"?>
<!-- Currency widget: fixed-size content (dp) in flexible rows, so any widget size keeps the same proportions. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/cur_header"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <ImageView
                android:id="@+id/hdr_feels"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="15"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/sep0"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:src="@drawable/cur_sep"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitXY" />
            <ImageView
                android:id="@+id/ic0"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_drop"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/hdr_hum"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="4"
                android:layout_marginStart="3dp"
                android:scaleType="fitStart" />
            <ImageView
                android:id="@+id/sep1"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:src="@drawable/cur_sep"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitXY" />
            <ImageView
                android:id="@+id/ic1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sunrise"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/hdr_rise"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="6"
                android:layout_marginStart="3dp"
                android:scaleType="fitStart" />
            <ImageView
                android:id="@+id/sep2"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:src="@drawable/cur_sep"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitXY" />
            <ImageView
                android:id="@+id/ic2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sunset"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/hdr_set"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="6"
                android:layout_marginStart="3dp"
                android:scaleType="fitStart" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/cur_clocks"
            android:clipToOutline="true"
            android:padding="1dp">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_0"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_0"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_0"
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_1"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_1"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_1"
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_2"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_2"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_2"
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_3"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_3"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_3"
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:background="@drawable/cur_row_light"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/fl_a_0"
                    android:layout_width="32dp"
                    android:layout_height="27dp"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/code_a_0"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="6dp"
                    android:scaleType="fitStart" />
                <ImageView
                    android:id="@+id/arrow_0"
                    android:layout_width="12dp"
                    android:layout_height="16dp"
                    android:src="@drawable/cur_arrow"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="10dp"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/fl_b_0"
                    android:layout_width="32dp"
                    android:layout_height="27dp"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/code_b_0"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="6dp"
                    android:scaleType="fitStart" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="108dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/mkt_lbl_0"
                        android:layout_width="40dp"
                        android:layout_height="14dp"
                        android:scaleType="fitStart" />
                    <ImageView
                        android:id="@+id/mkt_val_0"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:scaleType="fitEnd" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">
                    <ImageView
                        android:id="@+id/visa_logo_0"
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:scaleType="fitStart" />
                    <ImageView
                        android:id="@+id/visa_val_0"
                        android:layout_width="0dp"
                        android:layout_height="17dp"
                        android:layout_weight="1"
                        android:scaleType="fitEnd" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
