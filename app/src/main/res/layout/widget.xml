                android:gravity="center|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFF1F5F9"
                android:paddingStart="3dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1.85"
            android:background="@drawable/cur_clocks"
            android:orientation="horizontal"
            android:padding="1dp">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    
                    android:scaleType="fitXY"
                     />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">
                    <TextView
                        android:id="@+id/clk_day_0"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFCBD5E1"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_time_0"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.7"
                        android:autoSizeMaxTextSize="26sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_city_0"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    
                    android:scaleType="fitXY"
                     />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">
                    <TextView
                        android:id="@+id/clk_day_1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFCBD5E1"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_time_1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.7"
                        android:autoSizeMaxTextSize="26sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_city_1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    
                    android:scaleType="fitXY"
                     />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">
                    <TextView
                        android:id="@+id/clk_day_2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFCBD5E1"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_time_2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.7"
                        android:autoSizeMaxTextSize="26sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_city_2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
