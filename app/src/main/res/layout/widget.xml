<?xml version="1.0" encoding="utf-8"?>
<!-- Currency widget: native views in weighted rows, so it follows any widget width and height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55"
            android:background="@drawable/cur_header"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:id="@+id/hdr_feels"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/carbonplus_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFF1F5F9"
                />

            <ImageView
                android:id="@+id/sep0"
                android:layout_width="1dp"
                android:layout_height="12dp"
                
                android:scaleType="fitXY"
                android:src="@drawable/cur_sep" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/ic0"
                android:layout_width="14dp"
                android:layout_height="14dp"
                
                android:scaleType="fitCenter"
                android:src="@drawable/ic_drop" />
            <TextView
                android:id="@+id/hdr_hum"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/carbonplus_regular"
                android:gravity="center|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFF1F5F9"
                android:paddingStart="3dp" />

            <ImageView
                android:id="@+id/sep1"
                android:layout_width="1dp"
                android:layout_height="12dp"
                
                android:scaleType="fitXY"
                android:src="@drawable/cur_sep" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/ic1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sunrise" />
            <TextView
                android:id="@+id/hdr_rise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/carbonplus_regular"
                android:gravity="center|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFF1F5F9"
                android:paddingStart="3dp" />

            <ImageView
                android:id="@+id/sep2"
                android:layout_width="1dp"
                android:layout_height="12dp"
                
                android:scaleType="fitXY"
                android:src="@drawable/cur_sep" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/ic2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                
