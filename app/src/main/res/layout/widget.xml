                     />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">
                    <TextView
                        android:id="@+id/clk_day_3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFCBD5E1"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_time_3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.7"
                        android:autoSizeMaxTextSize="26sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                    <TextView
                        android:id="@+id/clk_city_3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1.1"
            android:background="@drawable/cur_row_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="56"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/fl_a_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:scaleType="fitCenter"
                     />
                <TextView
                    android:id="@+id/code_a_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="9"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="@font/carbonplus_regular"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFF1F5F9"
                    android:paddingStart="6dp" />
                <ImageView
                    android:id="@+id/arrow_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cur_arrow" android:padding="3dp" />
                <ImageView
                    android:id="@+id/fl_b_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:scaleType="fitCenter"
                     />
                <TextView
                    android:id="@+id/code_b_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="9"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="@font/carbonplus_regular"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFF1F5F9"
                    android:paddingStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="34"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/mkt_lbl_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center_vertical|start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FF8A9BB2"
                        />
                    <TextView
                        android:id="@+id/mkt_val_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.4"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center_vertical|end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/visa_logo_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:scaleType="fitStart"
                         android:paddingTop="3dp" android:paddingBottom="3dp" />
                    <TextView
                        android:id="@+id/visa_val_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.4"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center_vertical|end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFCBD5E1"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1.1"
            android:background="@drawable/cur_row_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="56"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/fl_a_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:scaleType="fitCenter"
                     />
                <TextView
                    android:id="@+id/code_a_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="9"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="@font/carbonplus_regular"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFF1F5F9"
                    android:paddingStart="6dp" />
                <ImageView
                    android:id="@+id/arrow_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cur_arrow" android:padding="3dp" />
                <ImageView
                    android:id="@+id/fl_b_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:scaleType="fitCenter"
                     />
                <TextView
                    android:id="@+id/code_b_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="9"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="@font/carbonplus_regular"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFF1F5F9"
                    android:paddingStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="34"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/mkt_lbl_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center_vertical|start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FF8A9BB2"
                        />
                    <TextView
                        android:id="@+id/mkt_val_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.4"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/carbonplus_regular"
                        android:gravity="center_vertical|end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFF1F5F9"
                        />
